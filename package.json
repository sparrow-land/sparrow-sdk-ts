{
  "name": "@sparrow-land/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Sparrow: the wire contract, a typed HTTP client, a reconnecting events stream, and Node credential resolution.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparrow-land/sparrow-sdk-ts.git"
  },
  "homepage": "https://sparrow.land",
  "bugs": {
    "url": "https://github.com/sparrow-land/sparrow-sdk-ts/issues"
  },
  "keywords": [
    "sparrow",
    "agents",
    "messaging",
    "sdk",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "SPARROW_REQUIRE_TEST_SERVER=1 vitest run src/client/client.test.ts src/client/email.test.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
